# OpenAI Realtime API Key
OPENAI_API_KEY=your_openai_api_key_here

# Callsign for the amateur radio station
CALLSIGN=AI7HAM

# Radio CAT Serial Settings
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=38400

# Audio Devices (names or index numbers from /api/devices or console)
# Set empty or None to auto-detect USB Audio CODEC, or default device
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# S-Meter Threshold (raw 0-255: ~80 corresponds to S4 on FT-991A)
S_METER_THRESHOLD=80

# Timing settings (in milliseconds)
RX_HANG_TIME_MS=800
PRE_TX_DELAY_MS=200
POST_TX_DELAY_MS=250
MAX_TX_DURATION_SEC=30

# Web server port (defaults to 80, falls back to >10000 if occupied)
PORT=80
HOST=0.0.0.0

# Recording settings
RECORDINGS_ENABLED=true
RECORDING_FORMAT=opus
RECORDING_BITRATE=32k
MIN_FREE_DISK_MB=500
MAX_RECORDINGS_MB=5000

# Mode
SIMULATED_MODE=false
